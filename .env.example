APP_NAME=赤霄 Alpha

# Keep this unchanged during migration if data/app.db already contains encrypted TuShare tokens.
APP_SECRET=local-dev-change-me-before-cloud-deploy

# Local/cloud single-server default:
DATABASE_URL=sqlite:////app/data/app.db
MARKET_DATA_CACHE_BACKEND=database
MARKET_DATA_CACHE_DIR=/app/data/tushare

# A-share realtime trading engine v1.3
TRADING_LOOP_SECONDS=60
TRADING_RUN_ON_START=true
TRADING_DRY_RUN=true
TRADING_SYMBOLS=
TRADING_MAX_CANDIDATES=20
TRADING_MIN_TURNOVER_YI=2.0
TRADING_CONFIDENCE_THRESHOLD=0.62
TRADING_MAX_POSITION_WEIGHT=0.12
TRADING_PUSH_ENABLED=true
TRADING_SEND_IN_DRY_RUN=false
TRADING_TUSHARE_TOKEN=
TRADING_TUSHARE_BASE_URL=
TRADING_MINIMAX_API_KEY=
TRADING_MINIMAX_ENDPOINT=
TRADING_MINIMAX_MODEL=minimax-production-model
TRADING_FEISHU_WEBHOOK_URL=
TRADING_HEALTH_MAX_STALE_SECONDS=300

# Use :80 for IP-only HTTP access. After DNS points to the server, set this
# to your domain, for example app.example.com, to let Caddy enable HTTPS.
APP_SITE_ADDRESS=:80
TLS_ADMIN_EMAIL=admin@example.com

# Cloud PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/ashare_alpha
