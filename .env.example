APP_NAME=赤霄 Alpha

# Keep this unchanged during migration if data/app.db already contains encrypted TuShare tokens.
APP_SECRET=local-dev-change-me-before-cloud-deploy

# Local/cloud single-server default:
DATABASE_URL=sqlite:////app/data/app.db
MARKET_DATA_CACHE_BACKEND=database
MARKET_DATA_CACHE_DIR=/app/data/tushare

# Cloud PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/ashare_alpha
