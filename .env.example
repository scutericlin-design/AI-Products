APP_NAME=赤霄 Alpha

# Keep this unchanged during migration if data/app.db already contains encrypted TuShare tokens.
APP_SECRET=local-dev-change-me-before-cloud-deploy

# Local/cloud single-server default:
DATABASE_URL=sqlite:////app/data/app.db
MARKET_DATA_CACHE_BACKEND=database
MARKET_DATA_CACHE_DIR=/app/data/tushare

# A-share realtime trading engine v1.3
TRADING_LOOP_SECONDS=60
TRADING_RUN_ON_START=true
TRADING_DRY_RUN=true
TRADING_SYMBOLS=
TRADING_MAX_CANDIDATES=20
TRADING_MIN_TURNOVER_YI=2.0
TRADING_CONFIDENCE_THRESHOLD=0.62
TRADING_MAX_POSITION_WEIGHT=0.12
TRADING_PUSH_ENABLED=true
TRADING_SEND_IN_DRY_RUN=false
TRADING_TUSHARE_TOKEN=
TRADING_TUSHARE_BASE_URL=
TRADING_MINIMAX_API_KEY=
TRADING_MINIMAX_ENDPOINT=
TRADING_MINIMAX_MODEL=stepfun-ai/step-3.7-flash
TRADING_MINIMAX_FALLBACK_MODEL=minimaxai/minimax-m3
TRADING_FEISHU_WEBHOOK_URL=
TRADING_HEALTH_MAX_STALE_SECONDS=300

# Hermes knowledge chain
KNOWLEDGE_ENABLED=true
KNOWLEDGE_COMMAND_SECRET=
KNOWLEDGE_PUBLIC_BASE_URL=http://182.254.227.131
KNOWLEDGE_DOWNLOAD_TOKEN_TTL_SECONDS=604800
KNOWLEDGE_STUDY_WORKSPACE=notebooklm
KNOWLEDGE_STUDY_WORKSPACE_LABEL=NotebookLM
KNOWLEDGE_STACK_DIR=/app/knowledge-base-stack
KNOWLEDGE_RESEARCH_INPUTS_DIR=/app/knowledge-base-stack/research-pack-inputs
KNOWLEDGE_SOURCE_PACKS_DIR=/app/knowledge-base-stack/notebooklm-source-packs
KNOWLEDGE_GITHUB_ARCHIVE_ENABLED=false
KNOWLEDGE_GITHUB_ARCHIVE_REPO_URL=git@github.com:scutericlin-design/personal-knowledge-archive.git
KNOWLEDGE_GITHUB_ARCHIVE_DIR=/app/data/knowledge-github-archive
KNOWLEDGE_GITHUB_ARCHIVE_BRANCH=main
KNOWLEDGE_GITHUB_ARCHIVE_PATH_PREFIX=
KNOWLEDGE_GITHUB_ARCHIVE_AUTHOR_NAME=Hermes Knowledge Bot
KNOWLEDGE_GITHUB_ARCHIVE_AUTHOR_EMAIL=hermes-knowledge-bot@users.noreply.github.com
KNOWLEDGE_GITHUB_ARCHIVE_SSH_KEY_FILE=/app/data/knowledge-github-archive-deploy-key
KNOWLEDGE_GITHUB_ARCHIVE_INCLUDE_TEXT=false
KNOWLEDGE_GITHUB_ARCHIVE_PUSH=true
NOTION_API_KEY=
NOTION_VERSION=2022-06-28
NOTION_SETUP_JSON=/app/knowledge-base-stack/notion-setup-result.json

# OpenAI-compatible LLM. SiliconFlow example.
LLM_PROVIDER=SiliconFlow
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=Qwen/Qwen2.5-7B-Instruct

# Feishu inbound verification and outbound replies.
FEISHU_VERIFICATION_TOKEN=
FEISHU_BOT_APP_ID=
FEISHU_BOT_APP_SECRET=
FEISHU_REPLY_ENABLED=true
KNOWLEDGE_FEISHU_WEBHOOK_URL=

# Google Drive bridge for NotebookLM Drive sources.
GOOGLE_DRIVE_ENABLED=false
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_SHARE_WITH_EMAIL=
GOOGLE_SERVICE_ACCOUNT_FILE=/app/data/google-service-account.json
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_OAUTH_TOKEN_FILE=/app/data/google-oauth-token.json
GOOGLE_OAUTH_TOKEN_JSON=

# Onyx and study-workspace bridge metadata.
ONYX_WORKSPACE_URL=https://cloud.onyx.app/app
ONYX_SYNC_WEBHOOK_URL=
ONYX_API_KEY=
IMA_WORKSPACE_URL=https://ima.qq.com/
IMA_DEFAULT_SPACE_URL=
NOTEBOOKLM_WORKSPACE_URL=https://notebooklm.google.com/
NOTEBOOKLM_DEFAULT_NOTEBOOK_URL=

# Use :80 for IP-only HTTP access. After DNS points to the server, set this
# to your domain to let Caddy enable HTTPS automatically.
APP_IP_ADDRESS=182.254.227.131
APP_SITE_ADDRESS=app.chixiaoalpha.cn
TLS_ADMIN_EMAIL=admin@chixiaoalpha.cn

# Cloud PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/ashare_alpha
